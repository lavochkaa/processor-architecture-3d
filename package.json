{
  "name": "processor-architecture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --grep-invert @a11y",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:budget": "node scripts/check-budget.mjs",
    "build": "astro check && astro build"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@react-three/fiber": "9.8.1",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
